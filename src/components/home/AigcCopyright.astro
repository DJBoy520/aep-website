---
import SectionTitle from '../common/SectionTitle.astro';
import { getLangFromPath, getLocalizedPath, getTranslation } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);
const a = t.aigc;
---

<!-- AIGC 版权确权：把"人类智力投入"四要素固化为可核验过程证据（浅色，与全站统一） -->
<section>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <SectionTitle title={a.title} subtitle={a.subtitle} align="center" />
    <p class="mx-auto mt-6 max-w-3xl text-center leading-relaxed text-[var(--text-secondary)]">{a.lead}</p>

    <!-- 消极规则引用块 -->
    <blockquote class="mx-auto mt-10 max-w-3xl rounded-xl border-l-4 border-aep-amber bg-aep-amber/5 p-5 sm:p-6">
      <p class="text-[0.986rem] leading-relaxed text-[var(--text-secondary)]">{a.negativeRule}</p>
    </blockquote>

    <!-- 四要素卡片 -->
    <h3 class="mt-14 text-center text-sm font-bold uppercase tracking-widest text-[var(--text-secondary)]">{a.factorsTitle}</h3>
    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {a.factors.map((f, i) => (
        <div class="rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 shadow-card">
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-aep-primary/10 text-sm font-bold text-aep-primary-ink">{i + 1}</span>
            <h4 class="text-lg font-bold tracking-tight text-[var(--text-primary)]">{f.name}</h4>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">{f.desc}</p>
          <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-[var(--border-color)] pt-4">
            <span class="text-xs font-semibold uppercase tracking-wide text-[var(--text-secondary)]">{f.aepLabel}</span>
            <code class="rounded-md bg-[var(--code-inline-bg)] px-2 py-1 font-mono text-xs text-[var(--code-inline-text)]">{f.aep}</code>
          </div>
        </div>
      ))}
    </div>

    <!-- 输出信号条 -->
    <div class="mt-8 flex flex-col gap-3 rounded-xl border border-aep-primary/25 bg-aep-primary/5 p-6 sm:flex-row sm:items-center sm:gap-5">
      <div class="flex items-center gap-3 sm:shrink-0">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-aep-primary/10 text-aep-primary-ink">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        <h3 class="text-lg font-bold tracking-tight text-[var(--text-primary)]">{a.signalTitle}</h3>
      </div>
      <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{a.signalDesc}</p>
    </div>

    <!-- 标准与法源 -->
    <h3 class="mt-14 text-center text-sm font-bold uppercase tracking-widest text-[var(--text-secondary)]">{a.citationsTitle}</h3>
    <div class="mt-5 flex flex-wrap justify-center gap-2.5">
      {a.citations.map((c) => (
        <span class="rounded-full border border-[var(--border-color)] bg-[var(--bg-secondary)] px-3.5 py-1.5 text-xs font-medium text-[var(--text-secondary)]">
          {c}
        </span>
      ))}
    </div>

    <!-- 免责 + CTA -->
    <div class="mt-10 flex flex-col gap-5 border-t border-[var(--border-color)] pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-2xl text-xs leading-relaxed text-[var(--text-secondary)]">{a.disclaimer}</p>
      <a
        href={getLocalizedPath('/protocol', lang)}
        class="group inline-flex w-fit shrink-0 items-center gap-1.5 text-sm font-semibold text-aep-primary-ink transition-colors duration-200 hover:underline"
      >
        {a.cta}
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>
