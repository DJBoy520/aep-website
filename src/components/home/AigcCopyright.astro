---
import { getLangFromPath, getLocalizedPath, getTranslation } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);
const a = t.aigc;

// 四要素配色（深色 feature 段内固定色，保证在 navy 底上对比充足，不随主题翻转）
const accents = [
  { text: 'text-cyan-300', ring: 'ring-cyan-400/30', dot: 'bg-cyan-400', chip: 'bg-cyan-400/10 text-cyan-200 ring-cyan-400/25' },
  { text: 'text-violet-300', ring: 'ring-violet-400/30', dot: 'bg-violet-400', chip: 'bg-violet-400/10 text-violet-200 ring-violet-400/25' },
  { text: 'text-emerald-300', ring: 'ring-emerald-400/30', dot: 'bg-emerald-400', chip: 'bg-emerald-400/10 text-emerald-200 ring-emerald-400/25' },
  { text: 'text-amber-300', ring: 'ring-amber-400/30', dot: 'bg-amber-400', chip: 'bg-amber-400/10 text-amber-200 ring-amber-400/25' },
];
---

<!-- AIGC 版权确权：把"人类智力投入"四要素固化为可核验过程证据（深色 feature 段） -->
<section class="relative overflow-hidden bg-aep-navy text-white">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -left-24 top-0 h-72 w-72 rounded-full bg-aep-primary/20 blur-3xl"></div>
    <div class="absolute -right-16 bottom-0 h-80 w-80 rounded-full bg-aep-purple/20 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <!-- 段首 -->
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-cyan-200 ring-1 ring-white/15">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4Z" />
          <path d="M9 12l2 2 4-4" />
        </svg>
        {a.badge}
      </span>
      <h2 class="mt-4 text-balance text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {a.title}
      </h2>
      <p class="mt-4 text-lg font-semibold leading-relaxed text-slate-200">{a.subtitle}</p>
      <p class="mt-3 text-base leading-relaxed text-slate-400">{a.lead}</p>
    </div>

    <!-- 消极规则引用块 -->
    <blockquote class="mt-8 max-w-3xl rounded-xl border-l-4 border-amber-400/80 bg-white/[0.04] p-5 sm:p-6">
      <p class="text-[0.986rem] leading-relaxed text-slate-200">{a.negativeRule}</p>
    </blockquote>

    <!-- 四要素卡片 -->
    <h3 class="mt-14 text-sm font-bold uppercase tracking-widest text-slate-400">{a.factorsTitle}</h3>
    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {a.factors.map((f, i) => (
        <div class={`aep-glass rounded-xl p-6 ring-1 ${accents[i % 4].ring} transition duration-300 ease-aep hover:bg-white/[0.08]`}>
          <div class="flex items-center gap-3">
            <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-sm font-bold ${accents[i % 4].text} bg-white/5`}>
              {i + 1}
            </span>
            <h4 class="text-lg font-bold tracking-tight text-white">{f.name}</h4>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">{f.desc}</p>
          <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-white/10 pt-4">
            <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">{f.aepLabel}</span>
            <code class={`rounded-md px-2 py-1 font-mono text-xs ring-1 ${accents[i % 4].chip}`}>{f.aep}</code>
          </div>
        </div>
      ))}
    </div>

    <!-- 输出信号条 -->
    <div class="mt-8 flex flex-col gap-3 rounded-xl bg-gradient-to-r from-cyan-500/15 via-violet-500/15 to-emerald-500/15 p-6 ring-1 ring-white/10 sm:flex-row sm:items-center sm:gap-5">
      <div class="flex items-center gap-3 sm:shrink-0">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-emerald-300 ring-1 ring-white/15">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        <h3 class="text-lg font-bold tracking-tight text-white">{a.signalTitle}</h3>
      </div>
      <p class="text-sm leading-relaxed text-slate-300">{a.signalDesc}</p>
    </div>

    <!-- 标准与法源 -->
    <h3 class="mt-14 text-sm font-bold uppercase tracking-widest text-slate-400">{a.citationsTitle}</h3>
    <div class="mt-5 flex flex-wrap gap-2.5">
      {a.citations.map((c) => (
        <span class="rounded-full bg-white/[0.06] px-3.5 py-1.5 text-xs font-medium text-slate-300 ring-1 ring-white/10">
          {c}
        </span>
      ))}
    </div>

    <!-- 免责 + CTA -->
    <div class="mt-10 flex flex-col gap-5 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-2xl text-xs leading-relaxed text-slate-500">{a.disclaimer}</p>
      <a
        href={getLocalizedPath('/protocol', lang)}
        class="group inline-flex w-fit shrink-0 items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-aep-navy transition duration-200 ease-aep hover:bg-cyan-100"
      >
        {a.cta}
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>
