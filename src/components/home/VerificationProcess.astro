---
import SectionTitle from '../common/SectionTitle.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const steps = t.verification.steps;
---

<!-- 验证流程：左 7 阶段列表 + 右验证结果卡 -->
<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
  <SectionTitle title={t.verification.title} subtitle={t.verification.subtitle} align="center" />

  <div class="mt-14 grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <!-- 左：7 个步骤（序号徽章 + 竖线连接） -->
    <ol>
      {steps.map((step, i) => (
        <li class="flex gap-4 pb-6 last:pb-0">
          <div class="flex flex-col items-center">
            <span
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-aep-primary/10 text-sm font-semibold text-aep-primary"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            {i < steps.length - 1 && (
              <span class="mt-1 w-px flex-1 border-l border-dashed border-[var(--border-color)]" aria-hidden="true"></span>
            )}
          </div>
          <div class="pt-1.5">
            <p class="font-medium text-[var(--text-primary)]">{step}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- 右：验证结果展示卡 -->
    <div class="flex justify-center">
      <div class="w-full max-w-sm rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] p-10 text-center">
        <!-- 绿色盾牌 SVG：circle 底 + 对勾 path，外圈 pulse 光环 -->
        <div class="relative mx-auto h-20 w-20" aria-hidden="true">
          <span class="absolute inset-0 animate-ping rounded-full bg-aep-green/20"></span>
          <svg class="relative h-20 w-20 text-aep-green" viewBox="0 0 80 80" fill="none">
            <circle cx="40" cy="40" r="38" fill="currentColor" fill-opacity="0.12" />
            <circle cx="40" cy="40" r="30" stroke="currentColor" stroke-width="3" />
            <path
              d="M27 41l9 9 17-18"
              stroke="currentColor"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
        <h3 class="mt-6 text-2xl font-bold text-aep-green">{t.verification.resultTitle}</h3>
        <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-aep-green/10 px-4 py-1 text-sm font-medium text-aep-green">
          {t.verification.resultLevel}: {t.verification.levelValue}
        </div>
      </div>
    </div>
  </div>
</section>
