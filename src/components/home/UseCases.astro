---
import SectionTitle from '../common/SectionTitle.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const items = t.useCases.items;
---

<!-- 应用场景：卡片网格（icon + 标题 + 具体业务痛点描述，悬停上浮） -->
<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
  <SectionTitle title={t.useCases.title} subtitle={t.useCases.subtitle} align="center" />

  <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <div class="group flex flex-col rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 transition duration-300 hover:-translate-y-1 hover:border-aep-primary/60 hover:shadow-lg">
        <div class="flex items-center gap-3">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-aep-primary/10 text-2xl transition group-hover:scale-110" aria-hidden="true">
            {item.icon}
          </div>
          <h3 class="text-base font-bold text-[var(--text-primary)] transition group-hover:text-aep-primary">
            {item.label}
          </h3>
        </div>
        {item.desc && (
          <p class="mt-4 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
            {item.desc}
          </p>
        )}
      </div>
    ))}
  </div>
</section>
