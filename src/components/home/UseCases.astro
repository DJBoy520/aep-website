---
import SectionTitle from '../common/SectionTitle.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const items = t.useCases.items;

// 场景图标（线框 SVG，24×24 viewBox，与条目顺序一一对应）
const icons: string[][] = [
  // 论文、专利与软件著作权保护：文档
  ['M14 3v5h5', 'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-5Z', 'M8 13h8', 'M8 17h5'],
  // 多媒体数据应用：图像
  ['M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z', 'M9.5 10a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z', 'M20 16l-4.5-4.5L6 21'],
  // AI Coding 与代码供应链：代码符号
  ['m9 8-4 4 4 4', 'm15 8 4 4-4 4', 'M13 6l-2 12'],
  // 司法出证与纠纷仲裁：法院
  ['M12 3l9 5H3l9-5Z', 'M5 21h14', 'M6 11v10', 'M10 11v10', 'M14 11v10', 'M18 11v10'],
  // 关键 Agent 行为与自动审批：芯片
  [
    'M6 5h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z',
    'M9 9h6v6H9z',
    'M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2',
  ],
  // AIGC 版权确权与原创性举证：保护盾 + 对勾
  ['M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z', 'M9 12l2 2 4-4'],
];

const emptyIcon: string[] = [];
const iconFor = (index: number): string[] => icons[index] ?? emptyIcon;
---

<!-- 核心落地应用场景：卡片网格（icon + 标题 + 描述，悬停上浮），整段铺浅色带 -->
<section class="bg-[var(--bg-secondary)]">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <SectionTitle title={t.useCases.title} subtitle={t.useCases.subtitle} align="center" />

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item, index) => (
        <div class="group relative flex flex-col overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 shadow-card transition duration-300 ease-aep hover:-translate-y-1 hover:border-aep-primary/50 hover:shadow-card-hover">
          <!-- 顶部品牌渐变描边（悬停显现） -->
          <span class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-aep-primary to-aep-purple transition-transform duration-300 ease-aep group-hover:scale-x-100" aria-hidden="true"></span>
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-aep-primary/10 text-aep-primary-ink transition duration-300 group-hover:bg-aep-primary/15 group-hover:scale-110" aria-hidden="true">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {iconFor(index).map((d) => <path d={d} />)}
              </svg>
            </div>
            <h3 class="text-base font-bold tracking-tight text-[var(--text-primary)] transition-colors duration-200 group-hover:text-aep-primary-ink">
              {item.label}
            </h3>
          </div>
          {item.desc && (
            <p class="mt-4 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
              {item.desc}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
