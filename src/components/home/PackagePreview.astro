---
import SectionTitle from '../common/SectionTitle.astro';
import CodeBlock from '../common/CodeBlock.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);

// 目录树：前缀（树形符号）+ 名称，目录用主题色加粗、文件用正文色
const treeLines: { prefix: string; name: string; isDir: boolean }[] = [
  { prefix: '', name: 'evidence.aep/', isDir: true },
  { prefix: '├── ', name: 'manifest.json', isDir: false },
  { prefix: '├── ', name: 'metadata/', isDir: true },
  { prefix: '│   └── ', name: 'identity/', isDir: true },
  { prefix: '├── ', name: 'artifacts/', isDir: true },
  { prefix: '├── ', name: 'events/', isDir: true },
  { prefix: '├── ', name: 'evidence_graph/', isDir: true },
  { prefix: '├── ', name: 'merkle/', isDir: true },
  { prefix: '└── ', name: 'signature/', isDir: true },
  { prefix: '    ├── ', name: 'signature.json', isDir: false },
  { prefix: '    └── ', name: 'signature.pub', isDir: false },
];

// 代码示例是代码内容（英文），按 AI_RULES 例外条款直接硬编码
const manifestJson = `{
  "protocol": "aep/1.0",
  "createdAt": "2026-08-09T10:00:00Z",
  "artifactCount": 3,
  "eventCount": 12,
  "hashAlgorithm": "sm3",
  "signatureAlgorithm": "sm2"
}`;

const signatureJson = `{
  "algorithm": "sm2",
  "signature": "base64...",
  "publicKey": "signature.pub",
  "signer": "did:aep:0x1a2b..."
}`;
---

<!-- 证据包预览：左目录树 + 右两个 JSON 示例 -->
<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
  <SectionTitle title={t.packagePreview.title} subtitle={t.packagePreview.subtitle} align="center" />

  <div class="mt-14 grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
    <!-- 左：目录树 -->
    <div class="overflow-x-auto rounded-lg border border-[var(--border-color)] bg-[var(--card-bg)] p-5">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-[var(--text-secondary)]">
        evidence.aep
      </p>
      <div class="font-mono text-sm leading-7">
        {treeLines.map((line) => (
          <div class="whitespace-pre">
            <span class="text-[var(--text-secondary)]" aria-hidden="true">{line.prefix}</span>
            <span class={line.isDir ? 'font-semibold text-aep-primary' : 'text-[var(--text-primary)]'}>
              {line.name}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- 右：两个代码示例 -->
    <div class="space-y-6">
      <CodeBlock code={manifestJson} language="manifest.json" />
      <CodeBlock code={signatureJson} language="signature.json" />
    </div>
  </div>
</section>
