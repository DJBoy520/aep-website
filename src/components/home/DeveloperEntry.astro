---
import Card from '../common/Card.astro';
import SectionTitle from '../common/SectionTitle.astro';
import { getLangFromPath, getLocalizedPath, getTranslation } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);

interface Entry {
  id: string;
  title: string;
  desc: string;
  status: 'available' | 'comingSoon';
  featured?: boolean;
}

const entries: Entry[] = [
  {
    id: 'mcp',
    title: t.developerEntry.mcpTitle,
    desc: t.developerEntry.mcpDesc,
    status: 'available',
    featured: true,
  },
  {
    id: 'cli',
    title: t.developerEntry.cliTitle,
    desc: t.developerEntry.cliDesc,
    status: 'available',
    featured: false,
  },
  {
    id: 'skills',
    title: t.developerEntry.skillsTitle,
    desc: t.developerEntry.skillsDesc,
    status: 'available',
    featured: false,
  },
];

// 状态标签样式：Available 绿色 + 圆点；Coming Soon 琥珀色（ink 令牌保证明暗主题均可读）
function statusClasses(status: Entry['status']): string {
  return status === 'available'
    ? 'bg-aep-green/10 text-aep-green-ink'
    : 'bg-aep-amber/10 text-aep-amber-ink';
}
---

<!-- 开发者入口：Evidence MCP 原生集成入口 + AEP CLI + Agent Skill 与运行时 -->
<section>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
  <SectionTitle title={t.developerEntry.title} subtitle={t.developerEntry.subtitle} align="center" />

  <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
    {entries.map((entry) => (
      <Card
        hover
        class={`relative flex flex-col ${
          entry.featured
            ? 'border-aep-primary/60 ring-2 ring-aep-primary/20 bg-gradient-to-b from-aep-primary/[0.06] via-[var(--card-bg)] to-[var(--card-bg)]'
            : ''
        }`}
      >
        {entry.featured && (
          <div class="mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-aep-fill-primary px-3 py-1 text-xs font-bold text-aep-on-fill">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              {t.developerEntry.coreBadge}
            </span>
          </div>
        )}

        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">{entry.title}</h3>
          <span
            class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ${statusClasses(
              entry.status,
            )}`}
          >
            {entry.status === 'available' && (
              <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
            )}
            {entry.status === 'available' ? t.common.available : t.common.comingSoon}
          </span>
        </div>

        <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">{entry.desc}</p>

        <a
          href={getLocalizedPath(entry.id === 'mcp' ? '/developer#mcp' : '/developer', lang)}
          class={`group/link mt-5 inline-flex w-fit items-center gap-1.5 rounded text-sm font-semibold text-aep-primary-ink transition-colors duration-200 hover:underline ${
            entry.featured ? 'hover:text-aep-purple-ink' : ''
          }`}
        >
          {t.common.learnMore}
          <span
            aria-hidden="true"
            class="transition-transform duration-200 group-hover/link:translate-x-0.5"
          >
            →
          </span>
        </a>
      </Card>
    ))}
  </div>
  </div>
</section>
