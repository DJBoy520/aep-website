---
import Button from '../common/Button.astro';
import { getLangFromPath, getLocalizedPath, getTranslation } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);
---

<!-- 首页 Hero：左侧文案 + 右侧抽象装饰（SVG 用 currentColor/主题色类适配明暗主题） -->
<section class="relative overflow-hidden bg-gradient-to-br from-aep-primary/5 via-transparent to-aep-purple/5">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <!-- 左：文案 -->
      <div>
        <!-- MCP 一等公民入口推荐徽章 -->
        <a
          href={getLocalizedPath('/developer', lang)}
          class="inline-flex items-center gap-2 rounded-full border border-aep-primary/30 bg-aep-primary/10 px-3.5 py-1.5 text-xs font-semibold text-aep-primary transition hover:border-aep-primary/50 hover:bg-aep-primary/15"
        >
          <span class="flex h-2 w-2 rounded-full bg-aep-primary animate-pulse" aria-hidden="true"></span>
          <span>{t.hero.mcpBadge}</span>
          <span aria-hidden="true" class="text-aep-primary/70">→</span>
        </a>

        <h1 class="mt-4 text-5xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-6xl">
          {t.hero.title} <span class="text-aep-primary">{t.hero.subtitle}</span>
        </h1>
        <p class="mt-5 text-xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-2xl">
          <span class="bg-gradient-to-r from-aep-primary to-aep-purple bg-clip-text text-transparent">{t.hero.slogan}</span>
        </p>
        <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">{t.hero.description}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button variant="primary" size="lg" href={getLocalizedPath('/developer', lang)}>
            {t.common.getStarted}
          </Button>
          <Button variant="outline" size="lg" href={getLocalizedPath('/protocol', lang)}>
            {t.common.viewProtocol}
          </Button>
          <Button variant="secondary" size="lg" href={getLocalizedPath('/downloads', lang)}>
            {t.common.downloadTools}
          </Button>
        </div>
      </div>

      <!-- 右：抽象装饰 SVG（渐变圆 + 几何图形） -->
      <div class="hidden lg:block" aria-hidden="true">
        <svg class="mx-auto w-full max-w-md text-aep-primary" viewBox="0 0 400 400" fill="none">
          <defs>
            <linearGradient id="hero-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="currentColor" stop-opacity="0.85" />
              <stop offset="100%" stop-color="currentColor" stop-opacity="0.1" />
            </linearGradient>
          </defs>
          <!-- 渐变主圆 -->
          <circle cx="200" cy="200" r="150" fill="url(#hero-grad)" />
          <!-- 圆环 -->
          <circle
            cx="200"
            cy="200"
            r="115"
            stroke="currentColor"
            stroke-opacity="0.35"
            stroke-width="1.5"
          />
          <!-- 内接方块（旋转 45° 形成菱形） -->
          <rect
            x="168"
            y="168"
            width="64"
            height="64"
            rx="8"
            transform="rotate(45 200 200)"
            fill="currentColor"
            fill-opacity="0.9"
          />
          <!-- 辅助点缀：小圆 + 小方（紫色系） -->
          <circle class="text-aep-purple" cx="92" cy="110" r="14" fill="currentColor" />
          <rect
            class="text-aep-green"
            x="296"
            y="92"
            width="24"
            height="24"
            rx="6"
            fill="currentColor"
          />
          <circle class="text-aep-blue" cx="318" cy="290" r="10" fill="currentColor" />
          <rect
            class="text-aep-amber"
            x="70"
            y="272"
            width="18"
            height="18"
            rx="5"
            fill="currentColor"
          />
        </svg>
      </div>
    </div>
  </div>
</section>
