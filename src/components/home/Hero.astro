---
import Button from '../common/Button.astro';
import { getLangFromPath, getLocalizedPath, getTranslation } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);
---

<!-- 首页 Hero：左侧文案 + 右侧"证据链"主题装饰（SVG 用 currentColor/主题色类适配明暗主题） -->
<section class="relative overflow-hidden">
  <!-- 背景氛围层：柔光网格 + 顶部渐隐结构线 -->
  <div class="aep-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="aep-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-28">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <!-- 左：文案 -->
      <div>
        <!-- MCP 核心集成入口推荐徽章 -->
        <a
          href={getLocalizedPath('/developer', lang)}
          class="inline-flex items-center gap-2 rounded-full border border-aep-primary/30 bg-aep-primary/10 px-3.5 py-1.5 text-xs font-semibold text-aep-primary-ink transition duration-200 ease-aep hover:border-aep-primary/60 hover:bg-aep-primary/15"
        >
          <span class="flex h-2 w-2 rounded-full bg-aep-primary animate-pulse" aria-hidden="true"></span>
          <span>{t.hero.mcpBadge}</span>
          <span aria-hidden="true" class="text-aep-primary-ink opacity-80">→</span>
        </a>

        <!-- 品牌字标：AEP 巨字 + 细竖线分隔 + 协议全称（避免超宽全角"｜"造成的空洞） -->
        <div class="mt-5 flex items-center gap-4">
          <h1 class="text-6xl font-extrabold tracking-tighter text-[var(--text-primary)] sm:text-7xl">
            AEP
          </h1>
          <span class="h-12 w-px shrink-0 bg-[var(--border-strong)] sm:h-14" aria-hidden="true"></span>
          <span class="text-lg font-semibold leading-tight tracking-tight text-aep-primary-ink sm:text-xl">
            Attestation<br />&amp; Evidence<br />Exchange Protocol
          </span>
        </div>

        <p class="mt-6 text-balance text-xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-2xl">
          <span class="bg-gradient-to-r from-[var(--aep-ink-primary)] to-[var(--aep-ink-purple)] bg-clip-text text-transparent">{t.hero.slogan}</span>
        </p>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-[var(--text-secondary)]">{t.hero.description}</p>
        <div class="mt-8 flex flex-wrap gap-3 sm:gap-4">
          <Button variant="primary" size="lg" href={getLocalizedPath('/developer', lang)}>
            {t.common.getStarted}
          </Button>
          <Button variant="outline" size="lg" href={getLocalizedPath('/protocol', lang)}>
            {t.common.viewProtocol}
          </Button>
          <Button variant="secondary" size="lg" href={getLocalizedPath('/downloads', lang)}>
            {t.common.downloadTools}
          </Button>
        </div>
      </div>

      <!-- 右：证据链主题装饰 SVG（区块链 + 存证封印 + 四要素卫星节点） -->
      <div class="relative hidden lg:block" aria-hidden="true">
        <div class="absolute inset-0 -z-10 mx-auto my-auto h-72 w-72 rounded-full bg-aep-primary/20 blur-3xl"></div>
        <svg class="mx-auto w-full max-w-md text-aep-primary" viewBox="0 0 420 420" fill="none">
          <defs>
            <linearGradient id="chain-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="currentColor" stop-opacity="0.9" />
              <stop offset="100%" stop-color="currentColor" stop-opacity="0.35" />
            </linearGradient>
            <linearGradient id="block-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="currentColor" stop-opacity="0.16" />
              <stop offset="100%" stop-color="currentColor" stop-opacity="0.05" />
            </linearGradient>
          </defs>

          <!-- 中心轨道环 -->
          <circle cx="210" cy="210" r="168" stroke="currentColor" stroke-opacity="0.12" stroke-width="1.5" />
          <circle cx="210" cy="210" r="120" stroke="currentColor" stroke-opacity="0.08" stroke-width="1.5" stroke-dasharray="3 7" />

          <!-- 证据链：三个区块由链节相连 -->
          <g stroke="url(#chain-grad)" stroke-width="2.5" stroke-linecap="round">
            <line x1="210" y1="120" x2="210" y2="150" />
            <line x1="210" y1="212" x2="210" y2="242" />
            <line x1="210" y1="304" x2="210" y2="330" />
          </g>
          <circle cx="210" cy="135" r="5" fill="currentColor" />
          <circle cx="210" cy="227" r="5" fill="currentColor" />

          <!-- 区块 1 -->
          <g>
            <rect x="140" y="150" width="140" height="62" rx="12" fill="url(#block-grad)" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.5" />
            <rect x="154" y="163" width="42" height="6" rx="3" fill="currentColor" fill-opacity="0.75" />
            <rect x="154" y="180" width="112" height="5" rx="2.5" fill="currentColor" fill-opacity="0.28" />
            <rect x="154" y="192" width="86" height="5" rx="2.5" fill="currentColor" fill-opacity="0.28" />
          </g>
          <!-- 区块 2 -->
          <g>
            <rect x="140" y="242" width="140" height="62" rx="12" fill="url(#block-grad)" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.5" />
            <rect x="154" y="255" width="42" height="6" rx="3" fill="currentColor" fill-opacity="0.75" />
            <rect x="154" y="272" width="112" height="5" rx="2.5" fill="currentColor" fill-opacity="0.28" />
            <rect x="154" y="284" width="72" height="5" rx="2.5" fill="currentColor" fill-opacity="0.28" />
          </g>

          <!-- 顶部：存证封印（盾牌 + 对勾） -->
          <g transform="translate(210 92)">
            <path d="M0 -30 L24 -20 V2 C24 20 12 30 0 34 C-12 30 -24 20 -24 2 V-20 Z" fill="currentColor" fill-opacity="0.92" />
            <path d="M-9 1 L-2 8 L11 -6" stroke="var(--bg-primary)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </g>

          <!-- 底部：链上锚点（立方体） -->
          <g transform="translate(210 356)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none">
            <path d="M0 -18 L18 -8 L0 2 L-18 -8 Z" fill="currentColor" fill-opacity="0.18" />
            <path d="M-18 -8 V8 L0 18 L0 2" fill="currentColor" fill-opacity="0.1" />
            <path d="M18 -8 V8 L0 18" />
          </g>

          <!-- 四要素卫星节点（提示词 / 参数 / 择优 / 后处理）连向链体 -->
          <g stroke-width="1.5" stroke-dasharray="2 5" stroke-opacity="0.5">
            <line class="text-aep-purple" x1="120" y1="170" x2="140" y2="178" stroke="currentColor" />
            <line class="text-aep-green" x1="300" y1="178" x2="280" y2="170" stroke="currentColor" />
            <line class="text-aep-blue" x1="120" y1="286" x2="140" y2="278" stroke="currentColor" />
            <line class="text-aep-amber" x1="300" y1="278" x2="280" y2="286" stroke="currentColor" />
          </g>
          <circle class="text-aep-purple" cx="112" cy="166" r="11" fill="currentColor" />
          <rect class="text-aep-green" x="292" y="158" width="22" height="22" rx="6" fill="currentColor" />
          <circle class="text-aep-blue" cx="112" cy="290" r="10" fill="currentColor" />
          <rect class="text-aep-amber" x="290" y="280" width="20" height="20" rx="6" fill="currentColor" />
        </svg>
      </div>
    </div>
  </div>
</section>
