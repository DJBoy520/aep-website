---
// 页脚。链接分组文案 Step 4 国际化时替换（任务书授权本步硬编码中文）。
const linkGroups = [
  {
    title: '文档',
    links: [
      { label: '协议', href: '/protocol' },
      { label: '架构', href: '/architecture' },
      { label: '安全', href: '/security' },
    ],
  },
  {
    title: '社区',
    links: [
      { label: '开发者', href: '/developer' },
      { label: '下载', href: '/downloads' },
    ],
  },
] as const;
---

<footer class="border-t border-[var(--border-color)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-10 sm:px-6 md:flex-row md:items-start md:justify-between">
    <!-- 左：版权 -->
    <div>
      <p class="text-sm text-[var(--text-secondary)]">© 2026 AEP Protocol</p>
    </div>

    <!-- 中：链接分组（两列） -->
    <nav class="flex gap-12" aria-label="页脚导航">
      {linkGroups.map((group) => (
        <div>
          <h3 class="mb-3 text-sm font-semibold text-[var(--text-primary)]">{group.title}</h3>
          <ul class="space-y-2">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-secondary)] transition-colors hover:text-aep-primary"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <!-- 右：GitHub 链接占位 -->
    <a
      href="https://github.com/"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-sm text-[var(--text-secondary)] transition-colors hover:text-aep-primary"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.66.41.36.78 1.05.78 2.12 0 1.54-.01 2.77-.01 3.15 0 .31.21.67.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
      </svg>
      GitHub
    </a>
  </div>
</footer>
