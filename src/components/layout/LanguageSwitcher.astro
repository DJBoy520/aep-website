---
import { getLangFromPath, getAlternatePath } from '@/i18n/utils';
import { localeLabels, locales } from '@/i18n/config';

const currentLang = getLangFromPath(Astro.url.pathname);
---

<div class="flex items-center gap-1 rounded-full border border-[var(--border-color)] p-0.5 text-sm">
  {locales.map((locale) => (
    <a
      href={getAlternatePath(Astro.url.pathname, locale)}
      aria-label={localeLabels[locale]}
      class:list={[
        'cursor-pointer rounded-full px-2.5 py-1 transition-colors hover:text-aep-primary',
        locale === currentLang
          ? 'bg-[var(--bg-secondary)] font-semibold text-[var(--text-primary)]'
          : 'text-[var(--text-secondary)]',
      ]}
    >
      {localeLabels[locale]}
    </a>
  ))}
</div>
