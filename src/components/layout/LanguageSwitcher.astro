---
import { getLangFromPath, getAlternatePath } from '@/i18n/utils';
import { localeLabels, locales } from '@/i18n/config';

const currentLang = getLangFromPath(Astro.url.pathname);
---

<div class="flex h-9 items-center gap-0.5 rounded-lg border border-[var(--border-color)] p-0.5 text-sm">
  {locales.map((locale) => (
    <a
      href={getAlternatePath(Astro.url.pathname, locale)}
      aria-label={localeLabels[locale]}
      class:list={[
        'inline-flex h-7 cursor-pointer items-center rounded-md px-2.5 transition-colors duration-200 hover:text-aep-primary-ink',
        locale === currentLang
          ? 'bg-aep-primary/10 font-semibold text-aep-primary-ink'
          : 'text-[var(--text-secondary)]',
      ]}
    >
      {localeLabels[locale]}
    </a>
  ))}
</div>
