---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string; // 有 href 渲染 <a>，无则渲染 <button>
  class?: string; // 追加自定义类
}

const { variant = 'primary', size = 'md', href, class: className } = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg font-medium transition duration-200 ease-aep active:translate-y-px';

const variantClasses: Record<'primary' | 'secondary' | 'outline', string> = {
  // 实心主按钮：填充色与文字成对（浅色主题深青底白字 5.36:1，深色主题高亮底深字 10.17:1）
  primary:
    'bg-aep-fill-primary text-aep-on-fill shadow-card hover:bg-aep-fill-primary-hover hover:shadow-card-hover',
  secondary:
    'bg-[var(--bg-secondary)] text-[var(--text-primary)] border border-[var(--border-color)] hover:border-[var(--border-strong)] hover:bg-[var(--card-bg)]',
  outline:
    'border border-aep-primary/60 text-aep-primary-ink hover:border-aep-primary hover:bg-aep-primary/10',
};

const sizeClasses: Record<'sm' | 'md' | 'lg', string> = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2 text-sm',
  lg: 'px-6 py-3 text-base',
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className]
  .filter(Boolean)
  .join(' ');

// 外链自动加安全属性
const isExternal = typeof href === 'string' && href.startsWith('http');
---

{href ? (
  <a
    href={href}
    class={classes}
    {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  >
    <slot />
  </a>
) : (
  <button type="button" class={classes}>
    <slot />
  </button>
)}
