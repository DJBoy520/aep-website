---
import Card from './Card.astro';
import { getTranslation } from '@/i18n/utils';

interface Props {
  name: string;
  status: 'available' | 'comingSoon';
  desc: string;
}

const { name, status, desc } = Astro.props;
const t = getTranslation(Astro.url.pathname);

// 状态标签样式：Available 绿色 + 圆点；Coming Soon 琥珀色（与首页 DeveloperEntry 一致）
const statusClasses =
  status === 'available'
    ? 'bg-aep-green/10 text-aep-green'
    : 'bg-aep-amber/10 text-aep-amber';
---

<!-- 工具卡片：名称 + 状态标签 + 描述 -->
<Card hover class="flex flex-col">
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-lg font-semibold text-[var(--text-primary)]">{name}</h3>
    <span
      class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ${statusClasses}`}
    >
      {status === 'available' && (
        <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
      )}
      {status === 'available' ? t.common.available : t.common.comingSoon}
    </span>
  </div>
  <p class="mt-3 flex-1 text-sm text-[var(--text-secondary)]">{desc}</p>
</Card>
