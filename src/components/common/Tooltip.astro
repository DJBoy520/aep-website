---
interface Props {
  termKey?: 'pki' | 'tsa' | 'trustedTimestamp' | 'smCrypto' | 'pqc' | 'certChain';
  text?: string;
  tip?: string;
  class?: string;
}

import { getLangFromPath, getTranslation } from '@/i18n/utils';

const { termKey, text, tip, class: className = '' } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);

let displayText = text;
let tooltipText = tip;

if (termKey && t.glossary && t.glossary[termKey]) {
  const g = t.glossary[termKey];
  if (!displayText) displayText = g.term;
  if (!tooltipText) tooltipText = g.tooltip;
}
---

<span
  class:list={[
    "tooltip-trigger inline-flex items-center border-b border-dashed border-aep-primary/60 text-inherit font-medium cursor-help relative group",
    className
  ]}
  tabindex="0"
  role="tooltip"
  aria-label={tooltipText}
>
  <span>{displayText}</span>
  <span class="sr-only">({tooltipText})</span>
  
  <span
    class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block group-focus:block z-50 w-64 p-2.5 rounded-lg bg-slate-900 text-slate-100 dark:bg-slate-800 dark:text-slate-100 text-xs leading-relaxed shadow-xl border border-slate-700/60 transition-opacity duration-200"
    role="tooltip"
  >
    <span class="block font-bold text-aep-primary mb-0.5">{displayText}</span>
    {tooltipText}
    <span class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-slate-900 dark:border-t-slate-800"></span>
  </span>
</span>
