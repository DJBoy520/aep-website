---
interface Props {
  code: string;
  language?: string; // 显示在代码块头部右侧的语言标签
}

const { code, language } = Astro.props;
---

<!-- 通用代码块：深色底 + 等宽字体 + 头部语言标签（调用方用模板字符串传 code，避免 Astro 解析花括号） -->
<div
  class="overflow-hidden rounded-xl border border-[var(--code-border)] bg-[var(--code-bg)] text-[var(--code-text)] shadow-card"
>
  {language && (
    <div
      class="flex items-center justify-end border-b border-[var(--code-border)] px-4 py-1.5"
    >
      <span
        class="select-none font-mono text-[11px] uppercase tracking-wider text-[var(--code-text)] opacity-60"
        aria-hidden="true"
      >
        {language}
      </span>
    </div>
  )}
  <pre class="overflow-x-auto p-4 text-sm leading-relaxed sm:p-5"><code>{code}</code></pre>
</div>
