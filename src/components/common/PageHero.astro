---
interface Props {
  title: string;
  subtitle?: string;
  kicker?: string; // 英文小标签（专有名词，直接传入）
}
const { title, subtitle, kicker } = Astro.props;
---

<!-- 内页统一品牌页头：柔光网格带 + 小标签 + 标题 + 副标题（与首页 Hero 同源的层次语言） -->
<section class="relative overflow-hidden border-b border-[var(--border-color)]">
  <div class="aep-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="aep-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 sm:py-16">
    {kicker && (
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-aep-primary-ink">
        {kicker}
      </p>
    )}
    <h1 class="mt-3 text-balance text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
      {title}
    </h1>
    {subtitle && (
      <p class="mx-auto mt-4 max-w-2xl text-balance leading-relaxed text-[var(--text-secondary)]">{subtitle}</p>
    )}
  </div>
</section>
