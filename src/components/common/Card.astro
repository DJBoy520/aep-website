---
interface Props {
  hover?: boolean; // 悬停上浮 + 阴影
  class?: string; // 追加自定义类
}

const { hover = false, class: className } = Astro.props;

// 卡片基线：圆角 rounded-xl + 1px 描边 + 随主题切换的层次阴影
const classes = [
  'rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 shadow-card',
  hover
    ? 'transition duration-300 ease-aep hover:-translate-y-1 hover:border-aep-primary/50 hover:shadow-card-hover'
    : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes}>
  <slot />
</div>
