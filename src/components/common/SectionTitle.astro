---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'left' } = Astro.props;
const isCenter = align === 'center';
---

<div class={isCenter ? 'text-center' : ''}>
  <h2
    class={`flex items-center gap-3 text-3xl font-bold text-[var(--text-primary)] ${
      isCenter ? 'justify-center' : ''
    }`}
  >
    <span class="h-6 w-1.5 rounded-full bg-aep-primary" aria-hidden="true"></span>
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-3 text-[var(--text-secondary)] ${isCenter ? 'mx-auto max-w-2xl' : ''}`}>
      {subtitle}
    </p>
  )}
</div>
