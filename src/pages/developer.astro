---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import Button from '../components/common/Button.astro';
import CodeBlock from '../components/common/CodeBlock.astro';
import ToolCard from '../components/common/ToolCard.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const d = t.developer;

// 工具矩阵数据：将 i18n 中的字符串 status 收敛为联合类型
interface Tool {
  name: string;
  status: 'available' | 'comingSoon';
  desc: string;
}

const tools: Tool[] = d.tools.map((tool) => ({
  name: tool.name,
  status: tool.status === 'available' ? 'available' : 'comingSoon',
  desc: tool.desc,
}));

// 快速开始三步对应的命令示例（代码内容，允许硬编码）
const stepCommands: string[] = [
  'curl -fsSL https://github.com/aep-protocol/aep-cli/releases/download/v0.1.0/install.sh | sh',
  'aep init my-project',
  'aep notarize artifact.md --project my-project',
];

// CLI 存证示例（多行）
const cliExample = `# init project
aep init my-project
# notarize a file
aep notarize report.md --project my-project
# validate the evidence package
aep validate evidence.aep`;

// MCP 调用示例（JSON 配置片段）
const mcpExample = `{
  "mcpServers": {
    "aep": {
      "command": "aep-mcp",
      "args": ["--project", "my-project"]
    }
  }
}`;
---

<MainLayout title={d.title} description={d.subtitle}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="space-y-16">
      <!-- 页面标题区 -->
      <div class="text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
          {d.title}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-[var(--text-secondary)]">{d.subtitle}</p>
      </div>

      <!-- 快速开始 -->
      <section>
        <SectionTitle title={d.quickStartTitle} />
        <div class="mt-10 space-y-8">
          {d.quickStartSteps.map((step, i) => (
            <div class="flex flex-col gap-4 sm:flex-row sm:gap-6">
              <div class="flex items-start gap-4 sm:w-72 sm:shrink-0 sm:pt-1">
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aep-primary to-aep-purple text-sm font-semibold text-white"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div>
                  <h3 class="font-semibold text-[var(--text-primary)]">{step.title}</h3>
                  <p class="mt-1 text-sm text-[var(--text-secondary)]">{step.desc}</p>
                </div>
              </div>
              <div class="min-w-0 flex-1">
                <CodeBlock code={stepCommands[i]} language="bash" />
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 工具矩阵 -->
      <section>
        <SectionTitle title={d.toolsTitle} />
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {tools.map((tool) => (
            <ToolCard name={tool.name} status={tool.status} desc={tool.desc} />
          ))}
        </div>
      </section>

      <!-- 示例代码 -->
      <section>
        <SectionTitle title={d.examplesTitle} />
        <div class="mt-10 space-y-6">
          <CodeBlock code={cliExample} language="bash" />
          <CodeBlock code={mcpExample} language="json" />
        </div>
      </section>

      <!-- 文档入口 -->
      <section>
        <SectionTitle title={d.docsTitle} />
        <p class="mt-6 max-w-2xl text-[var(--text-secondary)]">{d.docsDesc}</p>
        <div class="mt-8">
          <Button href="https://github.com/" variant="primary">
            {d.docsLink}
          </Button>
        </div>
      </section>
    </div>
  </section>
</MainLayout>
