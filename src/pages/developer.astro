---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import Button from '../components/common/Button.astro';
import CodeBlock from '../components/common/CodeBlock.astro';
import ToolCard from '../components/common/ToolCard.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const d = t.developer;

// 工具矩阵数据：将 i18n 中的字符串 status 收敛为联合类型
interface Tool {
  name: string;
  status: 'available' | 'comingSoon';
  desc: string;
}

const tools: Tool[] = d.tools.map((tool) => ({
  name: tool.name,
  status: tool.status === 'available' ? 'available' : 'comingSoon',
  desc: tool.desc,
}));

// 快速开始三步对应的命令示例（代码内容，允许硬编码）
// 1. 获取 CLI：从 aep-refimpl Releases 下载对应平台二进制后加入 PATH
const stepCommands: string[] = [
  '# 从 aep-refimpl Releases 下载对应平台的 CLI 二进制\n# https://github.com/DJBoy520/aep-refimpl/releases\nchmod +x ./aep && sudo mv ./aep /usr/local/bin/',
  'aep init --non-interactive && aep project create myproj',
  'aep notarize ./artifact --project myproj --verify -o artifact.aep',
];

// CLI 存证示例（多行）
const cliExample = `# 初始化身份与项目（首次使用）
aep init --non-interactive
aep project create myproj
# 存证：为文件/目录生成带签名的证据包并验证
aep notarize ./artifact --project myproj --verify -o artifact.aep
# 验证证据包（七阶段）
aep validate artifact.aep --json`;

// MCP 调用示例（JSON 配置片段）
const mcpExample = `{
  "mcpServers": {
    "aep": {
      "command": "aep-mcp"
    }
  }
}`;
---

<MainLayout title={d.title} description={d.subtitle}>
  <PageHero title={d.title} subtitle={d.subtitle} kicker="DEVELOPER CENTER" />
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="space-y-16">

      <!-- 快速开始 -->
      <section>
        <SectionTitle title={d.quickStartTitle} />
        <div class="mt-12 space-y-8">
          {d.quickStartSteps.map((step, i) => (
            <div class="flex flex-col gap-4 sm:flex-row sm:gap-6">
              <div class="flex items-start gap-4 sm:w-72 sm:shrink-0 sm:pt-1">
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aep-fill-primary to-aep-fill-accent text-sm font-semibold text-aep-on-fill"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div>
                  <h3 class="font-semibold tracking-tight text-[var(--text-primary)]">{step.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-[var(--text-secondary)]">{step.desc}</p>
                </div>
              </div>
              <div class="min-w-0 flex-1">
                <CodeBlock code={stepCommands[i]} language="bash" />
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 工具矩阵 -->
      <section id="mcp">
        <SectionTitle title={d.toolsTitle} subtitle={d.toolsSubtitle} />
        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {tools.map((tool) => (
            <ToolCard name={tool.name} status={tool.status} desc={tool.desc} />
          ))}
        </div>
      </section>

      <!-- 示例代码 -->
      <section>
        <SectionTitle title={d.examplesTitle} />
        <div class="mt-12 space-y-6">
          <CodeBlock code={cliExample} language="bash" />
          <CodeBlock code={mcpExample} language="json" />
        </div>
      </section>

      <!-- 文档入口 -->
      <section>
        <SectionTitle title={d.docsTitle} />
        <p class="mt-6 max-w-2xl leading-relaxed text-[var(--text-secondary)]">{d.docsDesc}</p>
        <div class="mt-8">
          <Button href="https://github.com/DJBoy520/aep-designs" variant="primary">
            {d.docsLink}
          </Button>
        </div>
      </section>
    </div>
  </section>
</MainLayout>
