---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/home/Hero.astro';
import Problems from '../components/home/Problems.astro';
import UseCases from '../components/home/UseCases.astro';
import AigcCopyright from '../components/home/AigcCopyright.astro';
import DeveloperEntry from '../components/home/DeveloperEntry.astro';
import { getLangFromPath, getLocalizedPath, getTranslation } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);
---

<MainLayout title={t.home.placeholderTitle} description={t.hero.description}>
  <!-- 首页核心区域：Hero → Problems → UseCases → AIGC 版权 → 基础设施一句 → DeveloperEntry -->
  <Hero />
  <Problems />
  <UseCases />
  <AigcCopyright />
  <!-- 基础设施详情移至架构页，首页仅留一句 + 链接 -->
  <section class="border-y border-[var(--border-color)]">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-10 text-center sm:flex-row sm:px-6 sm:text-left">
      <p class="max-w-2xl text-sm leading-relaxed text-[var(--text-secondary)]">{t.home.infraLine}</p>
      <a
        href={getLocalizedPath('/architecture', lang)}
        class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-aep-primary-ink transition-colors duration-200 hover:underline"
      >
        {t.common.learnMore}
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </section>
  <DeveloperEntry />
</MainLayout>
