---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/home/Hero.astro';
import EvidenceFlow from '../components/home/EvidenceFlow.astro';
import CryptoOverview from '../components/home/CryptoOverview.astro';
import PackagePreview from '../components/home/PackagePreview.astro';
import VerificationProcess from '../components/home/VerificationProcess.astro';
import DeveloperEntry from '../components/home/DeveloperEntry.astro';
import UseCases from '../components/home/UseCases.astro';
import ComingSoon from '../components/home/ComingSoon.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
---

<MainLayout title={t.home.placeholderTitle} description={t.hero.description}>
  <!-- 首页 8 个区块：Hero → EvidenceFlow → CryptoOverview → PackagePreview → VerificationProcess → DeveloperEntry → UseCases → ComingSoon（组件内部自行取 i18n） -->
  <Hero />
  <EvidenceFlow />
  <CryptoOverview />
  <PackagePreview />
  <VerificationProcess />
  <DeveloperEntry />
  <UseCases />
  <ComingSoon />
</MainLayout>
