---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import Card from '../components/common/Card.astro';
import Button from '../components/common/Button.astro';
import CodeBlock from '../components/common/CodeBlock.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const d = t.downloads;

// 下载链接指向真实仓库的 GitHub Releases；安装示例只引用发行页地址，不写死具体资产路径
const releasesUrl = 'https://github.com/DJBoy520/aep-refimpl/releases';
const runtimeReleasesUrl = 'https://github.com/DJBoy520/aep-releases';
const installCmd = `# 从 aep-refimpl Releases 下载对应平台的 CLI 二进制
# https://github.com/DJBoy520/aep-refimpl/releases
# 加入 PATH（示例：Linux / macOS）
chmod +x ./aep && sudo mv ./aep /usr/local/bin/`;
const mcpInstallCmd = `# Evidence MCP Server 与 AEP CLI 同属参考实现 aep-refimpl
# 发行物与获取方式见 https://github.com/DJBoy520/aep-refimpl`;
---

<MainLayout title={d.title} description={d.subtitle}>
  <PageHero title={d.title} subtitle={d.subtitle} kicker="DOWNLOAD CENTER" />
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="space-y-16">

      <!-- AEP CLI 区块 -->
      <section>
        <Card>
          <h2 class="text-xl font-bold tracking-tight text-[var(--text-primary)]">{d.cliTitle}</h2>
          <p class="mt-3 leading-relaxed text-[var(--text-secondary)]">{d.cliDesc}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            {d.cliPlatforms.map((platform) => (
              <Button href={releasesUrl} variant="outline">
                {platform}
              </Button>
            ))}
          </div>
          <p class="mt-4 text-sm leading-relaxed text-[var(--text-secondary)]">{d.binNote}</p>
          <h3 class="mt-8 text-sm font-semibold tracking-tight text-[var(--text-primary)]">
            {d.cliInstallTitle}
          </h3>
          <div class="mt-3">
            <CodeBlock code={installCmd} language="bash" />
          </div>
        </Card>
      </section>

      <!-- AEP MCP Server 区块 -->
      <section>
        <Card>
          <h2 class="text-xl font-bold tracking-tight text-[var(--text-primary)]">{d.mcpTitle}</h2>
          <p class="mt-3 leading-relaxed text-[var(--text-secondary)]">{d.mcpDesc}</p>
          <h3 class="mt-8 text-sm font-semibold tracking-tight text-[var(--text-primary)]">
            {d.mcpInstallTitle}
          </h3>
          <div class="mt-3">
            <CodeBlock code={mcpInstallCmd} language="bash" />
          </div>
        </Card>
      </section>

      <!-- AEP Skill 区块 -->
      <section>
        <Card>
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-xl font-bold tracking-tight text-[var(--text-primary)]">{d.skillTitle}</h2>
            <span
              class="rounded-full bg-aep-amber/10 px-3 py-0.5 text-sm font-medium text-aep-amber-ink"
            >
              {d.skillNote}
            </span>
          </div>
          <p class="mt-3 leading-relaxed text-[var(--text-secondary)]">{d.skillDesc}</p>
          <div class="mt-6">
            <Button href={runtimeReleasesUrl} variant="secondary">
              {d.download}
            </Button>
          </div>
        </Card>
      </section>

      <!-- 历史版本 -->
      <section>
        <SectionTitle title={d.historyTitle} />
        <p class="mt-6 max-w-2xl leading-relaxed text-[var(--text-secondary)]">{d.historyDesc}</p>
        <div class="mt-8">
          <Button href={releasesUrl} variant="secondary">
            {d.releasesLink}
          </Button>
        </div>
      </section>
    </div>
  </section>
</MainLayout>
