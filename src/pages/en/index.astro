---
import MainLayout from '@/layouts/MainLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Problems from '@/components/home/Problems.astro';
import UseCases from '@/components/home/UseCases.astro';
import AigcCopyright from '@/components/home/AigcCopyright.astro';
import InfraNetwork from '@/components/home/InfraNetwork.astro';
import DeveloperEntry from '@/components/home/DeveloperEntry.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
---

<MainLayout title={t.home.placeholderTitle} description={t.hero.description}>
  <!-- English homepage mirrors the Chinese one: Hero → Problems → UseCases → AIGC → InfraNetwork → DeveloperEntry -->
  <Hero />
  <Problems />
  <UseCases />
  <AigcCopyright />
  <InfraNetwork />
  <DeveloperEntry />
</MainLayout>
