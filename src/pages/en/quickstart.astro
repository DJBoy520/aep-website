---
import MainLayout from '@/layouts/MainLayout.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import CodeBlock from '@/components/common/CodeBlock.astro';
import Button from '@/components/common/Button.astro';
import { getTranslation, getLangFromPath, getLocalizedPath } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);
const isZh = lang === 'zh-cn';

const stepsZh = [
  {
    step: "01",
    title: "安装 AEP CLI 或 MCP Server",
    desc: "通过 npm 或预编译二进制一键安装命令行工具，或在 Claude / Cursor 中配置 Evidence MCP。",
    code: `# 使用 npm 全局安装 CLI
npm install -g @aep/cli

# 或通过 curl 一键安装二进制
curl -fsSL https://aep.org.cn/install.sh | bash`
  },
  {
    step: "02",
    title: "初始化机器身份与密钥对",
    desc: "基于 SM2 算法生成终端设备或 Agent 的私钥凭据与轻量化数字身份。",
    code: `# 生成并初始化 Agent 国密私钥与 DID 标识
aep identity init --name "my-agent" --algo sm2`
  },
  {
    step: "03",
    title: "签名与加盖可信时间戳",
    desc: "为关键操作数据、业务日志或制品生成自包含的证据包并加盖权威时间戳。",
    code: `# 对数据载荷进行签名存证并申请 TSA 时间戳
aep notarize ./data.json --output evidence.aep --tsa`
  },
  {
    step: "04",
    title: "独立离线验真",
    desc: "任何第三方接收方在脱离网络或中心化服务器时，均可独立核验全链路要素。",
    code: `# 验证证据包的完整性、签名有效性与时间戳
aep verify ./evidence.aep --report json`
  }
];

const stepsEn = [
  {
    step: "01",
    title: "Install AEP CLI or MCP Server",
    desc: "Install the CLI via npm or binary installer, or configure the Evidence MCP in Claude / Cursor.",
    code: `# Install CLI globally via npm
npm install -g @aep/cli

# Or install pre-built binary via curl
curl -fsSL https://aep.org.cn/install.sh | bash`
  },
  {
    step: "02",
    title: "Initialize Machine Identity & Keypair",
    desc: "Generate an SM2 private key and lightweight digital identity for your device or autonomous agent.",
    code: `# Generate and initialize SM2 keypair & DID
aep identity init --name "my-agent" --algo sm2`
  },
  {
    step: "03",
    title: "Sign & Attach Trusted Timestamp",
    desc: "Create self-contained evidence packages for transactions, logs, or artifacts with authoritative timestamps.",
    code: `# Sign payload and apply RFC 3161 TSA timestamp
aep notarize ./data.json --output evidence.aep --tsa`
  },
  {
    step: "04",
    title: "Independent Offline Verification",
    desc: "Any receiving entity can independently verify all cryptographic elements offline without centralized lock-in.",
    code: `# Verify container integrity, SM2 signature & timestamp
aep verify ./evidence.aep --report json`
  }
];

const steps = isZh ? stepsZh : stepsEn;
---

<MainLayout title="Quickstart - AEP" description="Get started with AEP in 5 minutes">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:py-16">
    <SectionTitle
      title="AEP 5-Minute Quickstart"
      subtitle="Zero-friction integration for lightweight digital trust, signing, and timestamping"
      align="center"
    />

    <div class="mt-12 space-y-10">
      {steps.map((item) => (
        <div class="relative flex flex-col md:flex-row gap-6 p-6 sm:p-8 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] shadow-sm">
          <div class="flex items-center gap-4 md:flex-col md:items-start md:w-1/3">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-aep-primary/10 text-xl font-black text-aep-primary">
              {item.step}
            </span>
            <div>
              <h3 class="text-lg font-bold text-[var(--text-primary)]">{item.title}</h3>
              <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">{item.desc}</p>
            </div>
          </div>
          <div class="flex-1 md:w-2/3">
            <CodeBlock code={item.code} language="bash" />
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Card -->
    <div class="mt-16 rounded-2xl border border-[var(--border-color)] bg-gradient-to-r from-aep-primary/10 via-transparent to-aep-purple/10 p-8 text-center">
      <h3 class="text-xl font-bold text-[var(--text-primary)]">
        Ready to Build Trusted Systems?
      </h3>
      <p class="mt-2 text-sm text-[var(--text-secondary)]">
        Explore full technical specifications or try our live verification tools
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <Button variant="primary" href={getLocalizedPath('/tools', lang)}>
          Try Online Tools
        </Button>
        <Button variant="secondary" href={getLocalizedPath('/protocol', lang)}>
          Read Specification
        </Button>
      </div>
    </div>
  </div>
</MainLayout>