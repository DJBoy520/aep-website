---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionTitle from '../../components/common/SectionTitle.astro';
import CodeBlock from '../../components/common/CodeBlock.astro';
import LayerDiagram from '../../components/architecture/LayerDiagram.astro';
import EvidenceGraph from '../../components/architecture/EvidenceGraph.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const a = t.architecture;

// 目录树是代码示例（英文），按 AI_RULES 例外条款直接硬编码
const treeCode = `evidence.aep/
├── manifest.json
├── metadata/
│   └── identity/
├── artifacts/
├── events/
├── evidence_graph/
├── merkle/
└── signature/
    ├── signature.json
    └── signature.pub`;
---

<MainLayout title={a.title} description={a.subtitle}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="space-y-16">
      <!-- 页面标题区 -->
      <div class="text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
          {a.title}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-[var(--text-secondary)]">{a.subtitle}</p>
      </div>

      <!-- 五层架构图 -->
      <section>
        <SectionTitle title={a.layersTitle} />
        <div class="mt-8 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-4 sm:p-8">
          <LayerDiagram layers={a.layers} />
        </div>
      </section>

      <!-- 证据图谱 -->
      <section>
        <SectionTitle title={a.graphTitle} />
        <p class="mt-4 text-[var(--text-secondary)]">{a.graphDesc}</p>
        <div class="mt-8 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-4 sm:p-8">
          <EvidenceGraph />
        </div>
      </section>

      <!-- 数据流 -->
      <section>
        <SectionTitle title={a.dataflowTitle} subtitle={a.dataflowSubtitle} />
        <ol class="mx-auto mt-8 max-w-3xl">
          {a.dataflowSteps.map((step, i) => (
            <li class="flex gap-6 pb-8 last:pb-0">
              <div class="flex flex-col items-center">
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aep-primary to-aep-purple text-sm font-semibold text-white"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                {i < a.dataflowSteps.length - 1 && (
                  <span class="mt-2 w-0.5 flex-1 bg-[var(--border-color)]" aria-hidden="true"></span>
                )}
              </div>
              <div class="pt-1.5">
                <p class="font-medium text-[var(--text-primary)]">{step}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- 包格式 -->
      <section>
        <SectionTitle title={a.packageTitle} />
        <p class="mt-4 text-[var(--text-secondary)]">{a.packageDesc}</p>
        <div class="mt-8">
          <CodeBlock code={treeCode} language="tree" />
        </div>
      </section>
    </div>
  </section>
</MainLayout>
