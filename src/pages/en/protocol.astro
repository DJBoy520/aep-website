---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import SectionTitle from '../../components/common/SectionTitle.astro';
import Card from '../../components/common/Card.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const p = t.protocol;

// Reference implementation (aep-refimpl v2.2.0) lands L0–L4 (L3 timestamping / L4 anchoring verified); L5–L7 are reserved
const isLevelImplemented = (idx: number) => idx <= 4;
---

<MainLayout title={p.title} description={p.subtitle}>
  <PageHero title={p.title} subtitle={p.subtitle} kicker="PROTOCOL SPECIFICATION" />
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="space-y-16">

      <!-- 协议概述 -->
      <section>
        <SectionTitle title={p.overviewTitle} />
        <div class="mt-8 space-y-4">
          {p.overview.map((para) => (
            <p class="leading-relaxed text-[var(--text-secondary)]">{para}</p>
          ))}
        </div>
      </section>

      <!-- 设计原则 -->
      <section>
        <SectionTitle title={p.principlesTitle} />
        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {p.principles.map((item) => (
            <Card hover>
              <h3 class="font-semibold tracking-tight text-aep-primary-ink">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">{item.desc}</p>
            </Card>
          ))}
        </div>
      </section>

      <!-- 核心概念 -->
      <section>
        <SectionTitle title={p.conceptsTitle} />
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {p.concepts.map((item) => (
            <div class="rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-5 shadow-card">
              <h3 class="font-semibold tracking-tight text-[var(--text-primary)]">{item.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-[var(--text-secondary)]">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 证据等级 -->
      <section>
        <SectionTitle title={p.levelsTitle} subtitle={p.levelsSubtitle} />
        <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {p.levels.map((item, index) => {
            const isImplemented = isLevelImplemented(index);
            return (
              <div
                class={`flex flex-col justify-between rounded-xl border p-5 shadow-card transition duration-300 ease-aep ${
                  isImplemented
                    ? 'border-aep-primary/40 bg-[var(--card-bg)] hover:border-aep-primary/70 hover:shadow-card-hover'
                    : 'border-dashed border-[var(--border-color)] bg-[var(--card-bg)]'
                }`}
              >
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <span
                      class={`shrink-0 rounded-md px-2.5 py-0.5 text-sm font-bold ${
                        isImplemented
                          ? 'bg-aep-fill-primary text-aep-on-fill'
                          : 'border border-[var(--border-color)] bg-[var(--bg-secondary)] text-[var(--text-secondary)]'
                      }`}
                    >
                      {item.level}
                    </span>
                    <span
                      class={`rounded-full px-2 py-0.5 text-xs font-semibold ${
                        isImplemented
                          ? 'border border-aep-green/30 bg-aep-green/10 text-aep-green-ink'
                          : 'border border-[var(--border-color)] bg-[var(--bg-secondary)] text-[var(--text-secondary)]'
                      }`}
                    >
                      {isImplemented ? p.levelImplemented : p.levelReserved}
                    </span>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">{item.desc}</p>
                </div>
              </div>
            );
          })}
        </div>
        <div class="mt-8 rounded-xl border border-aep-green/30 bg-aep-green/5 p-5 text-center shadow-card">
          <p class="text-sm font-medium leading-relaxed text-[var(--text-primary)]">{p.levelsStatus}</p>
        </div>
      </section>

      <!-- 与其他标准的关系 -->
      <section>
        <SectionTitle title={p.standardsTitle} />
        <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
          {p.standards.map((item) => (
            <Card hover>
              <h3 class="font-semibold tracking-tight text-aep-primary-ink">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">{item.desc}</p>
            </Card>
          ))}
        </div>
      </section>
    </div>
  </section>
</MainLayout>
