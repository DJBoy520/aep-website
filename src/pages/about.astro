---
import MainLayout from '@/layouts/MainLayout.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import Button from '@/components/common/Button.astro';
import Tooltip from '@/components/common/Tooltip.astro';
import { getTranslation, getLangFromPath, getLocalizedPath } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);
const a = t.about;
const isZh = lang === 'zh-cn';
---

<MainLayout title={isZh ? "产品介绍 / 关于项目 - AEP" : "About the Project - AEP"} description={a.subtitle}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:py-16">
    <SectionTitle
      title={a.title}
      subtitle={a.subtitle}
      align="center"
    />

    <!-- 问题痛点 -->
    <div class="mt-12 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 sm:p-8">
      <h3 class="text-xl font-bold text-[var(--text-primary)] flex items-center gap-2.5">
        <span class="text-2xl">⚠️</span>
        {a.problemTitle}
      </h3>
      <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">
        {a.problemDesc}
      </p>
    </div>

    <!-- 核心价值 -->
    <div class="mt-8 rounded-2xl border border-aep-primary/30 bg-aep-primary/5 p-6 sm:p-8">
      <h3 class="text-xl font-bold text-aep-primary flex items-center gap-2.5">
        <span class="text-2xl">💡</span>
        {a.valueTitle}
      </h3>
      <p class="mt-4 text-base leading-relaxed text-[var(--text-primary)] font-medium">
        {a.valueDesc}
      </p>
    </div>

    <!-- 可信基础设施服务矩阵 -->
    <div class="mt-16">
      <div class="text-center max-w-2xl mx-auto">
        <span class="rounded-full bg-aep-primary/10 px-3.5 py-1 text-xs font-semibold text-aep-primary">
          {a.matrixBadge}
        </span>
        <h2 class="mt-3 text-2xl font-bold text-[var(--text-primary)]">{a.visionTitle}</h2>
        <p class="mt-2 text-sm text-[var(--text-secondary)]">{a.visionDesc}</p>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-aep-primary block mb-1">{a.pkiDimension}</span>
            <h3 class="text-lg font-bold text-[var(--text-primary)]">{a.pkiTitle}</h3>
            <p class="mt-3 text-sm text-[var(--text-secondary)] leading-relaxed">{a.pkiDesc}</p>
          </div>
        </div>

        <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-aep-purple block mb-1">{a.tsaDimension}</span>
            <h3 class="text-lg font-bold text-[var(--text-primary)]">{a.tsaTitle}</h3>
            <p class="mt-3 text-sm text-[var(--text-secondary)] leading-relaxed">{a.tsaDesc}</p>
          </div>
        </div>

        <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-aep-green block mb-1">{a.chainDimension}</span>
            <h3 class="text-lg font-bold text-[var(--text-primary)]">{a.chainTitle}</h3>
            <p class="mt-3 text-sm text-[var(--text-secondary)] leading-relaxed">{a.chainDesc}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 底部行动 -->
    <div class="mt-16 text-center">
      <div class="inline-flex flex-wrap justify-center gap-4">
        <Button variant="primary" href={getLocalizedPath('/quickstart', lang)}>
          {t.common.getStarted}
        </Button>
        <Button variant="outline" href={getLocalizedPath('/protocol', lang)}>
          {t.common.viewProtocol}
        </Button>
      </div>
    </div>
  </div>
</MainLayout>