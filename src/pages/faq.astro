---
import MainLayout from '@/layouts/MainLayout.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import Tooltip from '@/components/common/Tooltip.astro';
import { getTranslation, getLangFromPath } from '@/i18n/utils';

const lang = getLangFromPath(Astro.url.pathname);
const t = getTranslation(Astro.url.pathname);
const faq = t.faq;
const isZh = lang === 'zh-cn';
---

<MainLayout title={isZh ? "常见问题 - AEP" : "FAQ - AEP"} description={faq.subtitle}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    <SectionTitle
      title={faq.title}
      subtitle={faq.subtitle}
      align="center"
    />

    <div class="mt-12 space-y-6">
      {faq.items.map((item, index) => (
        <details
          class="group rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 transition-all hover:border-aep-primary/50 open:shadow-lg open:shadow-aep-primary/5"
          open={index === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-[var(--text-primary)] text-base sm:text-lg">
            <span>{item.question}</span>
            <span class="ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-aep-primary/10 text-aep-primary transition-transform group-open:rotate-180">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-[var(--border-color)] text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- 术语速查 -->
    <div class="mt-16 p-8 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/50">
      <h3 class="text-base font-bold text-[var(--text-primary)] mb-4 flex items-center gap-2">
        <span class="flex h-2.5 w-2.5 rounded-full bg-aep-primary"></span>
        {isZh ? "核心名词与密码学概念速查" : "Glossary & Core Cryptographic Concepts"}
      </h3>
      <div class="flex flex-wrap gap-3">
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-[var(--card-bg)] border border-[var(--border-color)] text-xs font-mono">
          <Tooltip termKey="pki" text="PKI 公钥基础设施" />
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-[var(--card-bg)] border border-[var(--border-color)] text-xs font-mono">
          <Tooltip termKey="tsa" text="TSA 可信时间戳服务" />
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-[var(--card-bg)] border border-[var(--border-color)] text-xs font-mono">
          <Tooltip termKey="trustedTimestamp" text="可信时间戳" />
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-[var(--card-bg)] border border-[var(--border-color)] text-xs font-mono">
          <Tooltip termKey="smCrypto" text="商用密码 / 国密标准" />
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-[var(--card-bg)] border border-[var(--border-color)] text-xs font-mono">
          <Tooltip termKey="pqc" text="抗量子密码学 (PQC)" />
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-[var(--card-bg)] border border-[var(--border-color)] text-xs font-mono">
          <Tooltip termKey="certChain" text="证书链与层级信任" />
        </span>
      </div>
    </div>
  </div>
</MainLayout>