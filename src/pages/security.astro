---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import Card from '../components/common/Card.astro';
import { getTranslation } from '@/i18n/utils';

const t = getTranslation(Astro.url.pathname);
const s = t.security;
---

<MainLayout title={s.title} description={s.subtitle}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="space-y-16">
      <!-- 页面标题区 -->
      <div class="text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
          {s.title}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-[var(--text-secondary)]">{s.subtitle}</p>
      </div>

      <!-- 安全模型概述 -->
      <section>
        <SectionTitle title={s.modelTitle} />
        <div class="mt-8 space-y-4">
          {s.modelText.map((para) => (
            <p class="leading-relaxed text-[var(--text-secondary)]">{para}</p>
          ))}
        </div>
      </section>

      <!-- 密码学基础 -->
      <section>
        <SectionTitle title={s.cryptoTitle} />
        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {s.crypto.map((item) => (
            <Card hover>
              <h3 class="font-semibold text-aep-primary">{item.title}</h3>
              <p class="mt-2 text-sm text-[var(--text-secondary)]">{item.desc}</p>
            </Card>
          ))}
        </div>
      </section>

      <!-- 威胁模型 -->
      <section>
        <SectionTitle title={s.threatTitle} />
        <div class="mt-8 space-y-4">
          {s.threats.map((item) => (
            <div class="rounded-lg border border-[var(--border-color)] bg-[var(--card-bg)] p-5">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
                <span class="shrink-0 self-start rounded-md bg-amber-500/15 px-2.5 py-1 text-sm font-semibold text-amber-600 dark:text-amber-400">
                  {item.threat}
                </span>
                <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{item.desc}</p>
              </div>
              <div class="mt-3 flex items-start gap-2">
                <span class="shrink-0 text-sm font-semibold text-aep-green">{s.mitigationLabel}</span>
                <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{item.mitigation}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 验证流程详解 -->
      <section>
        <SectionTitle title={s.flowTitle} />
        <ol class="mx-auto mt-8 max-w-3xl">
          {s.flowSteps.map((step, i) => (
            <li class="flex gap-6 pb-8 last:pb-0">
              <div class="flex flex-col items-center">
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aep-primary to-aep-purple text-sm font-semibold text-white"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                {i < s.flowSteps.length - 1 && (
                  <span class="mt-2 w-0.5 flex-1 bg-[var(--border-color)]" aria-hidden="true"></span>
                )}
              </div>
              <div class="pt-1.5">
                <p class="font-medium text-[var(--text-primary)]">{step.stage}</p>
                <p class="mt-1 text-sm text-[var(--text-secondary)]">{step.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- 安全声明 -->
      <section>
        <SectionTitle title={s.statementTitle} />
        <ul class="mt-8 space-y-3">
          {s.statements.map((stmt) => (
            <li class="flex items-start gap-3 rounded-lg border border-[var(--border-color)] bg-[var(--card-bg)] p-4">
              <span class="mt-0.5 shrink-0 text-aep-green" aria-hidden="true">✓</span>
              <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{stmt}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</MainLayout>
