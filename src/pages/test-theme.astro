---
// Temporary test page for the global theme system (Step 2).
// Will be removed in Step 3.
import '@/styles/global.css';

// Sample code shown in the code block (avoids template-brace parsing).
const codeExample = "const theme = { primary: '#00B8D9' };";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Theme Test</title>
  </head>
  <body class="min-h-screen p-8">
    <main class="mx-auto max-w-4xl">
      <h1 class="mb-8 text-2xl font-bold">Theme Test</h1>

      <!-- AEP palette swatches -->
      <section class="mb-10">
        <h2 class="mb-4 text-lg font-semibold">AEP Colors</h2>
        <div class="flex flex-wrap gap-4">
          <div class="flex h-24 w-32 flex-col items-center justify-center rounded-lg bg-aep-primary text-sm font-medium text-white">primary</div>
          <div class="flex h-24 w-32 flex-col items-center justify-center rounded-lg bg-aep-purple text-sm font-medium text-white">purple</div>
          <div class="flex h-24 w-32 flex-col items-center justify-center rounded-lg bg-aep-green text-sm font-medium text-white">green</div>
          <div class="flex h-24 w-32 flex-col items-center justify-center rounded-lg bg-aep-amber text-sm font-medium text-white">amber</div>
          <div class="flex h-24 w-32 flex-col items-center justify-center rounded-lg bg-aep-blue text-sm font-medium text-white">blue</div>
          <div class="flex h-24 w-32 flex-col items-center justify-center rounded-lg bg-aep-navy text-sm font-medium text-white">navy</div>
        </div>
      </section>

      <!-- CSS variable container -->
      <section class="mb-10">
        <h2 class="mb-4 text-lg font-semibold">CSS Variables</h2>
        <div class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] p-6 text-[var(--text-primary)]">
          Variable container: bg-secondary / text-primary / border-color
        </div>
      </section>

      <!-- Code block -->
      <section>
        <h2 class="mb-4 text-lg font-semibold">Code Block</h2>
        <pre class="overflow-x-auto rounded-lg bg-[var(--code-bg)] p-6 text-[var(--code-text)]"><code>{codeExample}</code></pre>
      </section>
    </main>
  </body>
</html>
